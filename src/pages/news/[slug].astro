---
import { getCollection } from 'astro:content';
import { getNewsLocale, getNewsSlug } from '../../i18n/routing';
import RedirectPage from '../../layouts/RedirectPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  const englishEntries = entries.filter((entry) => getNewsLocale(entry.id) === 'en' && !entry.data.draft);

  return englishEntries.map((entry) => ({
    params: { slug: getNewsSlug(entry.id) },
  }));
}

const target = `/en/news/${Astro.params.slug}/`;
---

<RedirectPage target={target} />
